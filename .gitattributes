# Normaliza line endings — repo guarda LF, OS local escolhe no checkout.
* text=auto eol=lf

# Arquivos Windows-only sempre CRLF
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binários (nunca tocar)
*.png   binary
*.ico   binary
*.icns  binary
*.mp3   binary
*.wav   binary
*.mp4   binary

# Lockfiles (Linguist marca como gerado no GitHub pra não poluir stats)
package-lock.json   linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
